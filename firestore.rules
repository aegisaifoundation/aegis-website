rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is logged in
    function isLoggedIn() {
      return request.auth != null;
    }

    // Get user role from admins collection
    function getUserRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // Users allowed to edit general content
    function canEdit() {
      return isLoggedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'co_admin' ||
        getUserRole() == 'editor' ||
        getUserRole() == 'frontend_developer' ||
        getUserRole() == 'cto' ||
        getUserRole() == 'cpo'
      );
    }

    // Administrative users
    function isAdmin() {
      return isLoggedIn() && (
        getUserRole() == 'super_admin' ||
        getUserRole() == 'admin' ||
        getUserRole() == 'co_admin'
      );
    }

    // Helper validation checks for divisional groups
    function isExec() {
      return isLoggedIn() && (
        getUserRole() == 'super_admin' || getUserRole() == 'admin' || getUserRole() == 'co_admin' ||
        getUserRole() == 'ceo' || getUserRole() == 'cto' || getUserRole() == 'coo' || 
        getUserRole() == 'cfo' || getUserRole() == 'cmo' || getUserRole() == 'chro' || getUserRole() == 'ciso'
      );
    }

    // Helper checks if the user belongs to Tech & AI division
    function isTech() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'chief_ai_officer' || getUserRole() == 'ai_researcher' || getUserRole() == 'ml_engineer' || 
        getUserRole() == 'federated_learning_engineer' || getUserRole() == 'llm_engineer' || getUserRole() == 'data_scientist' || 
        getUserRole() == 'mlops_engineer' || getUserRole() == 'research_intern' || getUserRole() == 'vp_engineering' || 
        getUserRole() == 'engineering_manager' || getUserRole() == 'backend_developer' || getUserRole() == 'frontend_developer' || 
        getUserRole() == 'fullstack_developer' || getUserRole() == 'mobile_developer' || getUserRole() == 'devops_engineer' || 
        getUserRole() == 'qa_engineer' || getUserRole() == 'cloud_architect' || getUserRole() == 'sre' || 
        getUserRole() == 'kubernetes_engineer' || getUserRole() == 'network_engineer' || getUserRole() == 'database_administrator' ||
        getUserRole() == 'node_auditor' || getUserRole() == 'infrastructure_operator' || getUserRole() == 'system_engineer' ||
        getUserRole() == 'researcher'
      );
    }

    // Helper check if user belongs to Product & UX division
    function isProduct() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'cpo' || getUserRole() == 'product_manager' || getUserRole() == 'product_owner' || 
        getUserRole() == 'business_analyst' || getUserRole() == 'ux_researcher' || getUserRole() == 'frontend_developer' ||
        getUserRole() == 'editor' || getUserRole() == 'research_manager' || getUserRole() == 'research_director'
      );
    }

    // Helper check if user belongs to Cybersecurity division
    function isSecurity() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'security_architect' || getUserRole() == 'penetration_tester' || getUserRole() == 'soc_analyst' || 
        getUserRole() == 'compliance_officer' || getUserRole() == 'privacy_officer' || getUserRole() == 'security_officer' ||
        getUserRole() == 'node_auditor'
      );
    }

    // Helper check if user belongs to Sales & Marketing division
    function isSalesMarketing() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'cro' || getUserRole() == 'enterprise_sales_manager' || getUserRole() == 'solution_architect' || 
        getUserRole() == 'business_development_manager' || getUserRole() == 'account_manager' || getUserRole() == 'marketing_director' || 
        getUserRole() == 'digital_marketing_specialist' || getUserRole() == 'content_writer' || getUserRole() == 'brand_manager' || 
        getUserRole() == 'community_manager' || getUserRole() == 'devrel_manager' || getUserRole() == 'editor'
      );
    }

    // Helper check if user belongs to Finance or Operations division
    function isOpsFinance() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'operations_manager' || getUserRole() == 'program_manager' || getUserRole() == 'project_manager' || 
        getUserRole() == 'vendor_management' || getUserRole() == 'procurement_team' || getUserRole() == 'finance_manager' || 
        getUserRole() == 'accountant' || getUserRole() == 'financial_analyst' || getUserRole() == 'payroll_team' || 
        getUserRole() == 'investor_relations' || getUserRole() == 'billing_manager'
      );
    }

    // Helper check if user belongs to HR or Legal division
    function isHRLegal() {
      return isLoggedIn() && (
        isExec() || 
        getUserRole() == 'hr_manager' || getUserRole() == 'recruiter' || getUserRole() == 'talent_acquisition_specialist' || 
        getUserRole() == 'learning_development_team' || getUserRole() == 'employee_relations_team' || getUserRole() == 'general_counsel' || 
        getUserRole() == 'legal_officer' || getUserRole() == 'contract_manager' || getUserRole() == 'compliance_manager' || 
        getUserRole() == 'data_protection_officer' || getUserRole() == 'compliance_counsel'
      );
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Public users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin profiles
    match /admins/{uid} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && (isAdmin() || request.auth.uid == uid);
      allow update: if isLoggedIn() && (isAdmin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])));
      allow delete: if isLoggedIn() && isAdmin();
    }

    // Legacy admin collection
    match /admin/{document} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Website content
    match /website_data/{document} {
      allow read: if true;
      allow write: if canEdit();
    }

    // Node requests
    match /node_requests/{document} {
      allow create: if true;
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Nodes registry
    match /nodes/{document} {
      allow read: if true;
      allow write: if isAdmin() || isTech();
    }

    // Activity logs
    match /activity_logs/{document} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn();
    }

    // Website page builder templates
    match /website_pages/{document} {
      allow read: if true;
      allow write: if canEdit() || isProduct();
    }

    // Website version history
    match /website_versions/{document} {
      allow read: if isLoggedIn();
      allow write: if canEdit();
    }

    // Research publications
    match /research/{document} {
      allow read: if true;
      allow write: if canEdit() || isProduct() || isTech();
    }

    // Contact messages
    match /contact_messages/{document} {
      allow create: if true;
      allow read, update, delete: if isLoggedIn();
    }

    // Notifications
    match /notifications/{document} {
      allow create: if true;
      allow read, update, delete: if isLoggedIn();
    }

    // Pending approval queue
    match /pending_changes/{document} {
      allow create: if canEdit();
      allow read: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // Approved changes history
    match /approved_changes/{document} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // Media metadata
    match /media/{document} {
      allow read: if true;
      allow write: if canEdit();
    }

    // Site settings & Calibrations
    match /site_settings/{document} {
      allow read: if true;
      allow write: if isAdmin() || isExec() || isOpsFinance() || isHRLegal() || isProduct();
    }

    // Backup snapshots
    match /backups/{document} {
      allow read, write: if isAdmin();
    }

    // System notifications
    match /system_notifications/{document} {
      allow create: if isAdmin();
      allow read, update, delete: if isLoggedIn();
    }

    // ==========================================
    // DIVISIONAL WORKSPACE COLLECTIONS RULES
    // ==========================================

    // Executive Strategy Directives
    match /executive_strategy/{document} {
      allow read, write: if isExec();
    }

    // Executive Department statuses
    match /department_statuses/{document} {
      allow read: if isLoggedIn();
      allow write: if isExec();
    }

    // API Tokens Manager (CISO, Security Team, DevOps)
    match /api_tokens/{document} {
      allow read, write: if isSecurity() || isTech();
    }

    // Network Diagnostics & Telemetry (Systems, DevOps, SREs)
    match /diagnostic_logs/{document} {
      allow read, write: if isTech() || isSecurity();
    }

    // Payout Transactions (CFO, COO, billing managers)
    match /payout_transactions/{document} {
      allow read, write: if isOpsFinance();
    }

    // DAO Governance Proposals (Tech Division delegates)
    match /governance_proposals/{document} {
      allow read, write: if isTech();
    }

    // Support Tickets (Support agents, HR, Legal teams)
    match /support_tickets/{document} {
      allow read, write: if isTech() || isHRLegal();
    }

    // Partners Index (Sales, Marketing, DevRel, BDMs)
    match /partners/{document} {
      allow read, write: if isSalesMarketing() || isOpsFinance();
    }

    // Active System Warnings (CISO, SREs, SOC Analysts)
    match /system_alerts/{document} {
      allow read, write: if isSecurity() || isTech();
    }

    // Software Version Changelogs (Infrastructure & DevOps)
    match /changelogs/{document} {
      allow read, write: if isTech();
    }

    // Research Proposals Workflow (Researchers, Research Managers)
    match /research_proposals/{document} {
      allow read, write: if isTech() || isProduct();
    }

    // UI Provisioning Requests (Research Managers, Developers)
    match /ui_requests/{document} {
      allow read, write: if isProduct() || isTech();
    }

    // Talent Acquisition Applicants (HR Managers, Recruiters)
    match /talent_acquisition/{document} {
      allow read, write: if isHRLegal();
    }

    // Legal Contracts Vault (General Counsel, Contract Managers)
    match /legal_contracts/{document} {
      allow read, write: if isHRLegal();
    }

    // AI Checkpoints (Data Scientists, ML Engineers)
    match /model_checkpoints/{document} {
      allow read, write: if isTech();
    }

    // PR campaign announcements (Marketing, Sales, Writers)
    match /pr_drafts/{document} {
      allow read, write: if isSalesMarketing();
    }

    // Client Invoices Ledger (CFO, Billing)
    match /invoices/{document} {
      allow read, write: if isOpsFinance();
    }

    // ==========================================
    // TICKET MANAGEMENT MODULE SECURITY RULES
    // ==========================================

    function getUserDepartment(role) {
      return (role == 'vp_engineering' || role == 'engineering_manager' || role == 'ml_engineer' || role == 'federated_learning_engineer' || role == 'llm_engineer' || role == 'data_scientist' || role == 'mlops_engineer' || role == 'ai_researcher' || role == 'research_intern' || role == 'backend_developer' || role == 'frontend_developer' || role == 'fullstack_developer' || role == 'mobile_developer' || role == 'devops_engineer' || role == 'qa_engineer' || role == 'cloud_architect' || role == 'sre' || role == 'kubernetes_engineer' || role == 'network_engineer' || role == 'database_administrator' || role == 'system_engineer' || role == 'infrastructure_operator' || role == 'node_auditor' || role == 'cto' || role == 'chief_ai_officer') ? 'Technology & AI' :
             (role == 'cpo' || role == 'product_manager' || role == 'product_owner' || role == 'business_analyst' || role == 'ux_researcher') ? 'Product & UX' :
             (role == 'ciso' || role == 'security_architect' || role == 'penetration_tester' || role == 'soc_analyst' || role == 'compliance_officer' || role == 'privacy_officer' || role == 'security_officer') ? 'Cybersecurity & SOC' :
             (role == 'cro' || role == 'cmo' || role == 'enterprise_sales_manager' || role == 'solution_architect' || role == 'business_development_manager' || role == 'account_manager' || role == 'marketing_director' || role == 'digital_marketing_specialist' || role == 'content_writer' || role == 'brand_manager' || role == 'community_manager' || role == 'devrel_manager') ? 'Sales & Marketing' :
             (role == 'coo' || role == 'cfo' || role == 'operations_manager' || role == 'program_manager' || role == 'project_manager' || role == 'vendor_management' || role == 'procurement_team' || role == 'finance_manager' || role == 'accountant' || role == 'financial_analyst' || role == 'payroll_team' || role == 'investor_relations' || role == 'billing_manager') ? 'Operations & Finance' :
             (role == 'chro' || role == 'hr_manager' || role == 'recruiter' || role == 'talent_acquisition_specialist' || role == 'learning_development_team' || role == 'employee_relations_team' || role == 'general_counsel' || role == 'legal_officer' || role == 'contract_manager' || role == 'compliance_manager' || role == 'data_protection_officer' || role == 'compliance_counsel') ? 'HR & Legal' :
             (role == 'research_director' || role == 'research_manager' || role == 'researcher' || role == 'data_curator') ? 'Research' : 'Other';
    }

    function isManagerOfDept(dept) {
      return isLoggedIn() && (
        (dept == "Technology & AI" && (getUserRole() == 'cto' || getUserRole() == 'vp_engineering' || getUserRole() == 'engineering_manager' || getUserRole() == 'chief_ai_officer')) ||
        (dept == "Product & UX" && (getUserRole() == 'cpo' || getUserRole() == 'product_manager' || getUserRole() == 'product_owner')) ||
        (dept == "Cybersecurity & SOC" && (getUserRole() == 'ciso' || getUserRole() == 'security_officer')) ||
        (dept == "Sales & Marketing" && (getUserRole() == 'cro' || getUserRole() == 'cmo' || getUserRole() == 'marketing_director' || getUserRole() == 'enterprise_sales_manager')) ||
        (dept == "Operations & Finance" && (getUserRole() == 'coo' || getUserRole() == 'cfo' || getUserRole() == 'operations_manager' || getUserRole() == 'finance_manager')) ||
        (dept == "HR & Legal" && (getUserRole() == 'chro' || getUserRole() == 'hr_manager' || getUserRole() == 'general_counsel')) ||
        (dept == "Research" && (getUserRole() == 'research_director' || getUserRole() == 'research_manager'))
      );
    }

    function isAnyManager() {
      return isLoggedIn() && (
        getUserRole() == 'cto' || getUserRole() == 'vp_engineering' || getUserRole() == 'engineering_manager' || getUserRole() == 'chief_ai_officer' ||
        getUserRole() == 'cpo' || getUserRole() == 'product_manager' || getUserRole() == 'product_owner' ||
        getUserRole() == 'ciso' || getUserRole() == 'security_officer' ||
        getUserRole() == 'cro' || getUserRole() == 'cmo' || getUserRole() == 'marketing_director' || getUserRole() == 'enterprise_sales_manager' ||
        getUserRole() == 'coo' || getUserRole() == 'cfo' || getUserRole() == 'operations_manager' || getUserRole() == 'finance_manager' ||
        getUserRole() == 'chro' || getUserRole() == 'hr_manager' || getUserRole() == 'general_counsel' ||
        getUserRole() == 'research_director' || getUserRole() == 'research_manager'
      );
    }

    // Tickets Collection Rules
    match /tickets/{ticketId} {
      allow read: if isLoggedIn() && (
        isExec() || 
        resource.data.assigneeId == request.auth.uid ||
        resource.data.reporterId == request.auth.uid ||
        (getUserDepartment(getUserRole()) == resource.data.department && isManagerOfDept(resource.data.department))
      );
      allow create: if isLoggedIn() && (
        isExec() || 
        (getUserDepartment(getUserRole()) == request.resource.data.department && isManagerOfDept(request.resource.data.department))
      );
      allow update: if isLoggedIn() && (
        isExec() || 
        (getUserDepartment(getUserRole()) == resource.data.department && isManagerOfDept(resource.data.department)) ||
        (resource.data.assigneeId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'timestamp', 'technicalNotes']))
      );
      allow delete: if isLoggedIn() && (
        isExec() || 
        (getUserDepartment(getUserRole()) == resource.data.department && isManagerOfDept(resource.data.department))
      );
    }

    // Comments & Discussions
    match /ticket_comments/{document} {
      allow read, write: if isLoggedIn();
    }

    // Activity Log Audit Trail
    match /ticket_activity/{document} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
    }

    // Attachments Metadata
    match /ticket_attachments/{document} {
      allow read, write: if isLoggedIn();
    }

    // Employee & Department Directory
    match /department_members/{document} {
      allow read: if isLoggedIn();
      allow write: if isAdmin() || isHRLegal() || isExec();
    }

    // Ticket Assignments Map
    match /ticket_assignments/{document} {
      allow read, write: if isLoggedIn();
    }

    // Ticket Notifications
    match /ticket_notifications/{document} {
      allow read, write: if isLoggedIn();
    }

    // Metadata & Projects
    match /ticket_projects/{document} {
      allow read: if isLoggedIn();
      allow write: if isExec() || isAdmin() || isAnyManager();
    }

    // Sprints
    match /ticket_sprints/{document} {
      allow read: if isLoggedIn();
      allow write: if isExec() || isAdmin() || isAnyManager();
    }

    // Milestones
    match /ticket_milestones/{document} {
      allow read: if isLoggedIn();
      allow write: if isExec() || isAdmin() || isAnyManager();
    }
  }
}
